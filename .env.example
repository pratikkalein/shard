# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Your Google OAuth credentials (console.cloud.google.com)
# Redirect URI: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only email allowed to log in
ALLOWED_EMAIL=

# Generate with: node scripts/hash-password.mjs yourpassword
CREDENTIALS_PASSWORD_HASH=

# Upstash Redis — auto-filled when you connect via Vercel Integrations → Upstash
# Vercel adds these names automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (KV_REST_API_READ_ONLY_TOKEN, KV_URL, REDIS_URL are also added but not used by Shard)
