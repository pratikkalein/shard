# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Your Google OAuth credentials (console.cloud.google.com)
# Redirect URI: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only email allowed to log in
ALLOWED_EMAIL=

# Generate with: node scripts/hash-password.mjs yourpassword
CREDENTIALS_PASSWORD_HASH=

# Upstash Redis — auto-filled when you connect via Vercel Integrations → Upstash
# Vercel adds these names automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (KV_REST_API_READ_ONLY_TOKEN, KV_URL, REDIS_URL are also added but not used by Shard)

# Cloudflare R2 Storage (For serverless database-backed content delivery)
# region: auto is handled internally.
R2_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shard-content
R2_PUBLIC_URL=https://your-bucket-subdomain.r2.dev # Or custom domain

# Secret API Key used to authenticate the Obsidian plugin
SHARD_PUBLISH_KEY=
